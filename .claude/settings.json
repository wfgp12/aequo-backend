{
  "crossSessionInbound": "accept",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia-pruebas.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["../coordinacion", "../aequo-backend-tester"],
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:cov)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:mutacion)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npx stryker run *)",
      "Bash(npx tsc *)",
      "Bash(npx oxlint *)",
      "Bash(npx prettier *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --merged *)",
      "Bash(git branch -r --merged *)",
      "Bash(git branch -a)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git branch -D feature/*)",
      "Bash(git branch -D fix/*)",
      "Bash(git branch -D docs/*)",
      "Bash(git branch -D chore/*)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * switch *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * branch *)",
      "Bash(git -C * rev-parse *)",
      "Bash(cd ../aequo-backend-tester && npx vitest *)",
      "Bash(cd ../aequo-backend-tester && npx stryker run *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api repos/*)",
      "mcp__ccd_pr__get_status",
      "mcp__ccd_pr__bind_pr",
      "mcp__ccd_pr__set_auto_merge",
      "mcp__60411d8f-4ddf-4696-ac38-d3a93f537cb3__notion-fetch",
      "mcp__60411d8f-4ddf-4696-ac38-d3a93f537cb3__notion-search",
      "mcp__60411d8f-4ddf-4696-ac38-d3a93f537cb3__notion-query-data-sources",
      "mcp__60411d8f-4ddf-4696-ac38-d3a93f537cb3__notion-update-page",
      "mcp__60411d8f-4ddf-4696-ac38-d3a93f537cb3__notion-create-pages"
    ],
    "ask": [
      "Bash(git worktree *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npm uninstall *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push origin qa*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push origin --delete develop*)",
      "Bash(git push origin --delete qa*)",
      "Bash(git push origin :main*)",
      "Bash(git push origin :develop*)",
      "Bash(git push origin :qa*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D develop*)",
      "Bash(git branch -D qa*)"
    ]
  }
}

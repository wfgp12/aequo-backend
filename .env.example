PORT=3000
# Orígenes permitidos por CORS, separados por comas. Expo web usa localhost:8081; en producción, el origen de GitHub Pages.
CORS_ORIGINS=http://localhost:8081

# Firebase Admin (service account). Se obtienen en Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# No subir el JSON descargado ni los valores reales al repositorio. FIREBASE_PRIVATE_KEY va entre comillas, con los saltos de línea como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

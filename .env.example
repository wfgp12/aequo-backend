# Copiar este archivo a .env y llenar los valores. El .env no se versiona.
# Los valores de ejemplo son ficticios: reemplazarlos por los reales.

# Puerto del servidor.
PORT=3000

# Orígenes del frontend permitidos por CORS, separados por comas y sin espacios.
# Expo web usa localhost:8081; en producción, el origen de GitHub Pages (solo dominio, sin ruta).
# Ejemplo: CORS_ORIGINS=http://localhost:8081,https://wfgp12.github.io
CORS_ORIGINS=http://localhost:8081

# Cadena de conexión de MongoDB Atlas (Atlas > Database > Connect > Drivers).
# Incluye usuario, contraseña y el nombre de la base de datos (aequo) antes del "?".
# Si la contraseña tiene caracteres especiales (@ : / ?), codificarlos (por ejemplo @ = %40).
# Ejemplo: MONGODB_URI=mongodb+srv://aequo_user:mi_clave@cluster0.ab1cd.mongodb.net/aequo?retryWrites=true&w=majority
MONGODB_URI=

# Secreto para firmar el JWT de sesión propio (24 h). Cadena larga y aleatoria, solo para este entorno.
# Generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ejemplo: JWT_SECRET=9f2c...(96 caracteres hexadecimales)
JWT_SECRET=

# Firebase Admin (service account). Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Se copian del JSON descargado; ese JSON no se sube al repositorio.
# Ejemplo: FIREBASE_PROJECT_ID=aequo-finance
FIREBASE_PROJECT_ID=
# Ejemplo: FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aequo-finance.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=
# Entre comillas dobles y en una sola línea, con los saltos de línea escritos como \n.
# Ejemplo: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
